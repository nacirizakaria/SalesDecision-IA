# Django — copiez ce fichier vers .env, puis remplacez les valeurs "change-me".
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-generate-a-unique-random-key-of-at-least-50-characters
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com

DB_ENGINE=django.db.backends.mysql
DB_NAME=salesdecision
DB_USER=salesdecision_app
DB_PASSWORD=change-me-use-a-strong-unique-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60
MAX_UPLOAD_SIZE_MB=10

LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900

BACKUP_DIR=/secure/backups/salesdecision
BACKUP_ENCRYPTION_KEY=change-me-generate-with-fernet-generate-key

OPENAI_API_KEY=change-me-server-side-key
LLM_PROVIDER=ollama
OLLAMA_ASSISTANT_MODEL=qwen3:1.7b
OLLAMA_API_URL=http://127.0.0.1:11434/api/chat
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_MAX_OUTPUT_TOKENS=350
OLLAMA_NUM_THREADS=4
OLLAMA_KEEP_ALIVE=5m
ASSISTANT_HISTORY_MESSAGES=4
ASSISTANT_MEMORY_TTL_SECONDS=1800
OLLAMA_INTENT_TIMEOUT=30
ASSISTANT_USE_LLM_INTENT=True
